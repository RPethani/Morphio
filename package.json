{
  "version": "0.1.0-beta.8",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/RPethani/Morphio.git"
  },
  "bugs": {
    "url": "https://github.com/RPethani/Morphio/issues"
  },
  "homepage": "https://rpethani.github.io/Morphio/",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts}'",
    "prepare": "npm run build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "docs": "typedoc"
  },
  "husky": {
    "hooks": {
      "pre-commit": "eslint ."
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "morphio",
  "author": "Rakesh Pethani",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "size-limit": "^11.1.6",
    "ts-jest": "^29.3.1",
    "tsup": "^8.0.2",
    "typedoc": "^0.28.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
